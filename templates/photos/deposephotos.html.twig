{% extends "base1.html.twig" %}
{% block main_navigation %}
    {{ include('core/odpf-menu-haut.html.twig', {listfaq: listfaq}) }}
{% endblock %}

{% block title %} Photos des épreuves
    {% if concours=='cia' %}
        interacadémiques
    {% endif %}
    {% if concours =='national' %}
        nationales
    {% endif %}
    de la {{ edition.ed }}




{% endblock %}



{% block titre3 %}Déposer les photos des épreuves
    {% if concours=='inter' %}
        interacadémiques
    {% endif %}
    {% if concours =='cn' %}
        nationales
    {% endif %}

    {% if date()<app.session.get('edition').dateouverturesite %}
        {% set numEd=edition.ed-1 %}
    {% else %}
        {% set numEd=edition.ed %}
    {% endif %}
    de la {{ numEd }}<sup>e </sup>édition {% endblock %}


{% block body %}
    <div class="w-50 p-3">
        {% for message in app.session.flashbag.get('info') %}
            <div class="alert alert-info"> {{ message }}</div>
        {% endfor %}
        {% for message in app.session.flashbag.get('alert') %}
            <div class="alert alert-danger"> {{ message|raw }}</div>
        {% endfor %}
        {% for message in app.session.flashbag.get('success') %}
            <div class="alert alert-info"> {{ message }}</div>
        {% endfor %}
    </div>

    <div class="well">
        {% if app.user.roles|filter(v => v =='ROLE_PROF')!=[] %}

            <div style="color: #960004"> Ces photos ne seront visibles en public que le lendemain du concours
                {% if concours =='cia' %}
                    interacadémique
                {% endif %}
                {% if concours =='cn' %}
                    national
                {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="container">
        <div class="row">
            <div class="col">
                {# if your application defines multiple Dashboards #}
                {% if is_granted('ROLE_ORGACIA') %}

                    <a href="{{ path('affiche_table_photos_edition') }}" type="button" class="btn btn-secondary">
                        Voir les photos déposées
                    </a>
                {% endif %}
            </div>
        </div>
        <div class="row">
            <div class="col">
                {% form_theme form 'bootstrap_4_layout.html.twig' %}
                {{ form_start(form, {'attr': {'id': 'photo-upload-form'}}) }}
                <div class="my-custom-class-for-errors">
                    {{ form_errors(form) }}
                </div>
                <div class="form-row">
                    <div class="form-group col-6">
                        {{ form_row(form.equipe,{'label': 'Choisissez l\'équipe'}) }}
                    </div>
                    <div class="form-group col-6">
                        <div id="photo-drop-zone" class="photo-drop-zone" tabindex="0" role="button"
                             aria-controls="photos_files">
                            <p>Glissez-déposez vos photos ici ou cliquez pour les choisir.</p>
                            {{ form_row(form.photoFiles, {'label': 'Choisissez jusqu’à 5 fichiers (13 Mo maximum par photo)'}) }}
                            <div id="photo-drop-message" class="text-danger" role="alert"></div>
                        </div>
                    </div>
                </div>
                <div>Photos choisies</div>
                <div id="affichephotos">
                    <div class="row">

                        <img src="{{ asset('odpf/odpf-images/no_image_avalaible.png') }}" id="photo_preview"
                             width="220px">
                    </div>

                </div>
                <div class="form-row">

                    {% if app.user.roles|filter(v => v =='ROLE_PROF')!=[] %}
                        {{ form_widget(form.Valider, {'label':'Charger les photos '}) }}
                        <a href="{{ path('fichiers_choix_equipe',{choix:'liste_prof'}) }}" class="btn-secondary btn-lg"
                           role="button"> Annuler </a>
                    {% endif %}
                    {% if app.user.roles|filter(v => v =='ROLE_PROF')==[] %}
                        {{ form_widget(form.Valider, {'label':'Charger les photos '}) }}
                        <a href="{{ path('core_home') }}" class="btn-secondary btn-lg" role="button"> Annuler </a>
                    {% endif %}
                </div>
                <div id="photo-upload-progress" class="progress mt-3" style="display: none;"
                     role="progressbar" aria-label="Progression du dépôt" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="0">
                    <div id="photo-upload-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated"
                         style="width: 0%">0%</div>
                </div>
                <div id="photo-upload-status" class="mt-2" role="status" aria-live="polite"></div>

                {{ form_end(form) }}
                {% if app.user.roles|filter(v => v =='ROLE_PROF')!=[] %}
                    <a href="{{ path('photos_gestion_photos',{infos:concours~'-'~edition.id~'-prof-1'}) }}">Gerer les
                        photos</a>

                {% endif %}
            </div>
        </div>
    </div>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bs-custom-file-input/dist/bs-custom-file-input.min.js"></script>
        <script>bsCustomFileInput.init();</script>
    {% endblock %}

{% endblock %}