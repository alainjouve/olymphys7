{% extends 'base1.html.twig' %}

{% block titre3 %}
    Validation des invitations au concours national
{% endblock %}

{% block main_navigation %}
    <nav class="navbar navbar-expand-md navbar-light justify-content-between py-1">
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#invitation-navigation"
                aria-controls="invitation-navigation" aria-expanded="false" aria-label="Afficher le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand d-md-none" href="{{ path('core_home') }}">
            <img src="{{ asset('odpf/odpf-images/Phicompletblanc.png') }}" alt="Logo des OdpF">
        </a>
        <div class="collapse navbar-collapse justify-content-center" id="invitation-navigation">
            <ul class="navbar-nav">
                <li class="nav-item menurouge">
                    <a class="nav-link" href="{{ path('core_home') }}">Accueil du site</a>
                </li>
                {% block navigation %}{% endblock %}
                {% if is_granted("IS_AUTHENTICATED_REMEMBERED") %}
                    <li class="nav-item menu_haut">
                        <a class="nav-link" href="{{ path('profile_show') }}">{{ app.user.prenomNom }}</a>
                    </li>
                    <li class="nav-item menurouge">
                        <a class="nav-link" href="{{ path('logout') }}">Déconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item menurouge">
                        <a class="nav-link" href="{{ path('login') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>
{% endblock %}

{% block body %}
    <style>
        .logo {
            position: relative;
            text-align: center;
        }

        .logo img {
            width: 180px;
            height: auto;
        }

        .navbar-brand img {
            width: 105px;
            height: auto;
        }

        #qr-video {
            max-height: 60vh;
            min-height: 240px;
            object-fit: cover;
            background: #000;
        }

        @media (max-width: 576px) {
            .logo {
                display: none;
            }

            .logo ~ br {
                display: none;
            }

            .logo ~ .row h3 {
                margin: 0.5rem 0;
                font-size: 1.25rem;
            }

            .logo img {
                width: 130px;
            }

            #qr-video {
                max-height: 38vh;
                min-height: 180px;
            }
        }
    </style>
    <div class="container">
        <p>Scannez le QR code de l’invitation pour valider la présence de la personne.</p>
        <p class="text-muted">L’accès à la caméra nécessite une connexion sécurisée (HTTPS).</p>
        <div id="invitation-qr-scanner"
             data-csrf-token="{{ csrf_token('validation_invitations_cn') }}"
             data-validation-url="{{ path('valider_invitation_cn') }}">
            <video id="qr-video" class="w-100" hidden
                   autoplay muted playsinline></video>
            <div id="qr-status" class="alert alert-secondary" role="status" aria-live="polite">
                <span id="qr-loading-spinner" class="spinner-border spinner-border-sm mr-2 d-none" aria-hidden="true"></span>
                <span id="qr-status-message">Appuyez sur « Démarrer le scan » pour activer la caméra.</span>
                <div id="qr-result" aria-live="polite"></div>
            </div>
        </div>
        <div class="my-3">
            <button type="button" id="qr-start" class="btn btn-primary">Démarrer le scan</button>
            <a href="{{ path('liste_excel_invitations_cn') }}" class="btn btn-secondary">Liste des invitations</a>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('qr-scanner') }}
{% endblock %}
