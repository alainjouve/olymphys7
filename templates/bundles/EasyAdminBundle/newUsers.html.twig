{% extends '@EasyAdmin/crud/new.html.twig' %}

{% block new_form %}
    {{ form_start(new_form) }}
    {{ form_errors(new_form) }}
    <div class="row">
        <div class="col-md-6 col-sm-12">
            {{ form_row(new_form.id) }}
            {{ form_row(new_form.civilite) }}
            {{ form_row(new_form.nom) }}
            {{ form_row(new_form.prenom) }}
            {{ form_row(new_form.uaiId) }}
            {{ form_row(new_form.adresse) }}
            {{ form_row(new_form.ville) }}
            {{ form_row(new_form.code) }}
            {{ form_row(new_form.phone) }}
            {{ form_row(new_form.contact) }}

        </div>
        <div class="col-md-6 col-sm-12">
            {{ form_row(new_form.email) }}
            {{ form_row(new_form.username) }}
            {{ form_row(new_form.plainPassword) }}
            {{ form_row(new_form.roles) }}
            {{ form_row(new_form.centrecia) }}
            On donne l'autorisation à l'utilisateur de s'inscrire sur la plateforme Olymphys(AEFE, etrangers ou si pb
            sur Adage)
            <br>
            {{ form_row(new_form.autorisationInscription) }}
            {{ form_widget(new_form.autorisationListeDiffusion, {label: ' '}) }}
            <label for="{{ new_form.autorisationListeDiffusion.vars.id }}">
                J’accepte de recevoir des messages de diffusion d’Olymphys, notamment les informations importantes
                concernant les OdPF
            </label>
            {{ form_row(new_form.isActive) }}
            {{ form_row(new_form.token) }}
            {{ form_row(new_form.createdAt) }}
            {{ form_row(new_form.updatedAt) }}
            {{ form_row(new_form.lastVisit) }}
            {{ form_row(new_form.passwordRequestedAt) }}
        </div>
    </div>
    {{ form_end(new_form) }}
{% endblock new_form %}
